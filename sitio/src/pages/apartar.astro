---
import Base from "../layouts/Base.astro";
import Pendiente from "../components/Pendiente.astro";
import { ALTURAS, NEGOCIO, COBERTURA } from "../datos";

const alturas = ["1 a 1.5 m", "1.8 a 2.2 m", "2.5 a 3 m", "4 a 6 m", "Todavía no sé"];
---

<Base
  titulo="Apartar mi árbol de Navidad natural | Entrega en CDMX y Edomex"
  descripcion="Aparta tu árbol de Navidad natural de abeto noble. Dinos la altura, tu colonia y la fecha de entrega que quieres. Entrega a domicilio en CDMX y Estado de México."
  ruta="/apartar"
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:py-20">
    <h1 class="titulo text-4xl font-bold sm:text-5xl">Apartar mi árbol</h1>
    <p class="mt-4 text-lg text-tinta-suave">
      Déjanos tus datos y te confirmamos disponibilidad y precio por WhatsApp.
      Apartar no compromete el pago todavía.
    </p>

    {
      !NEGOCIO.whatsapp && (
        <p class="mt-6 rounded-lg border-2 border-dorado bg-[#FFF3D1] p-4 text-sm text-[#7A5400]">
          <strong>Nota para el equipo:</strong> falta configurar el número de
          WhatsApp en <code>src/datos.ts</code>. Mientras tanto el formulario no
          puede enviar. Ver <code>PENDIENTES.md</code>.
        </p>
      )
    }

    <form id="forma-apartado" class="mt-10 grid gap-5 rounded-xl border border-salvia bg-white p-6 sm:p-8">
      <div>
        <label for="nombre" class="block text-sm font-bold">Tu nombre</label>
        <input
          id="nombre" name="nombre" type="text" required autocomplete="name"
          class="mt-1.5 w-full rounded-md border border-salvia px-4 py-3 focus:border-dorado focus:outline-none focus:ring-2 focus:ring-dorado/40"
        />
      </div>

      <div>
        <label for="whatsapp" class="block text-sm font-bold">Tu WhatsApp</label>
        <input
          id="whatsapp" name="whatsapp" type="tel" required inputmode="tel"
          autocomplete="tel" placeholder="55 1234 5678" pattern="[0-9+()\s-]{10,20}"
          class="mt-1.5 w-full rounded-md border border-salvia px-4 py-3 focus:border-dorado focus:outline-none focus:ring-2 focus:ring-dorado/40"
        />
      </div>

      <div>
        <label for="altura" class="block text-sm font-bold">Altura que buscas</label>
        <select
          id="altura" name="altura" required
          class="mt-1.5 w-full rounded-md border border-salvia bg-white px-4 py-3 focus:border-dorado focus:outline-none focus:ring-2 focus:ring-dorado/40"
        >
          <option value="">Elige una altura…</option>
          {alturas.map((a) => <option value={a}>{a}</option>)}
        </select>
        <p class="mt-1.5 text-xs text-tinta-suave">
          ¿Dudas? <a href="/arboles" class="font-bold text-verde underline">Compara los tamaños aquí</a>.
        </p>
      </div>

      <div>
        <label for="colonia" class="block text-sm font-bold">Colonia y alcaldía o municipio</label>
        <input
          id="colonia" name="colonia" type="text" required
          placeholder="Ej. Bosques de las Lomas, Miguel Hidalgo"
          class="mt-1.5 w-full rounded-md border border-salvia px-4 py-3 focus:border-dorado focus:outline-none focus:ring-2 focus:ring-dorado/40"
        />
        <p class="mt-1.5 text-xs text-tinta-suave">Solo entregamos en {COBERTURA}.</p>
      </div>

      <div>
        <label for="fecha" class="block text-sm font-bold">Fecha de entrega que te gustaría</label>
        <input
          id="fecha" name="fecha" type="date"
          class="mt-1.5 w-full rounded-md border border-salvia px-4 py-3 focus:border-dorado focus:outline-none focus:ring-2 focus:ring-dorado/40"
        />
      </div>

      <div>
        <label for="notas" class="block text-sm font-bold">
          Algo más que debamos saber <span class="font-normal text-tinta-suave">(opcional)</span>
        </label>
        <textarea
          id="notas" name="notas" rows="3"
          placeholder="Piso, elevador, horario en el que hay quien reciba…"
          class="mt-1.5 w-full rounded-md border border-salvia px-4 py-3 focus:border-dorado focus:outline-none focus:ring-2 focus:ring-dorado/40"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mt-2 rounded-md bg-dorado px-6 py-4 font-bold text-verde transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-50"
        disabled={!NEGOCIO.whatsapp}
      >
        Enviar y seguir por WhatsApp
      </button>

      <p id="estado-forma" class="text-sm" role="status" aria-live="polite"></p>

      <p class="text-xs text-tinta-suave">
        Al enviar se abre WhatsApp con tu solicitud ya escrita. No pedimos pago
        en este paso.
      </p>
    </form>
  </section>
</Base>

<script define:vars={{ WHATSAPP: NEGOCIO.whatsapp, ENDPOINT: NEGOCIO.endpointFormulario }}>
  const forma = document.getElementById("forma-apartado");
  const estado = document.getElementById("estado-forma");

  forma?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!WHATSAPP) return;

    const d = Object.fromEntries(new FormData(forma));
    const boton = forma.querySelector('button[type="submit"]');
    boton.disabled = true;
    estado.textContent = "Enviando…";
    estado.className = "text-sm text-tinta-suave";

    // 1) Guardar la solicitud. Si aún no hay endpoint configurado, no se
    //    pierde nada: el mensaje de WhatsApp lleva todos los datos.
    if (ENDPOINT) {
      try {
        await fetch(ENDPOINT, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ ...d, origen: "sitio-web", fechaEnvio: new Date().toISOString() }),
        });
      } catch (err) {
        console.error("No se pudo guardar la solicitud:", err);
      }
    }

    // 2) Abrir WhatsApp con el mensaje ya escrito.
    const mensaje = [
      "Hola, quiero apartar un árbol 🎄",
      "",
      `Nombre: ${d.nombre}`,
      `Altura: ${d.altura}`,
      `Colonia: ${d.colonia}`,
      d.fecha ? `Fecha que me gustaría: ${d.fecha}` : null,
      d.notas ? `Notas: ${d.notas}` : null,
    ].filter(Boolean).join("\n");

    estado.textContent = "Listo. Abriendo WhatsApp…";
    estado.className = "text-sm font-bold text-verde";
    window.location.href = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
    setTimeout(() => (boton.disabled = false), 2500);
  });
</script>
